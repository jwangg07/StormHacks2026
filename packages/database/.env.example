# Server-side only. Copy these values into the API/server environment.
ENABLE_TIGER_DATA=false
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DATABASE_REQUIRED=false
DATABASE_POOL_MAX=5
PERSISTENCE_FLUSH_INTERVAL_MS=1000
PERSISTENCE_BATCH_SIZE=100
PERSISTENCE_QUEUE_CAPACITY=5000
PERSISTENCE_FINAL_MATCH_RETRIES=3
